{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/index.js",
    "src/phab.js",
    "src/github.js",
    "src/ignore-store.js",
    "src/bin/**/*.js",
    "src/types.d.ts"
  ]
}
